# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "A typed functional language with an optimizing compiler and bytecode VM"
description: """
Glyph is a strict functional programming language implemented entirely in OCaml.
It includes a hand-written lexer and parser, Hindley-Milner type inference,
pattern compilation, SSA mid-level IR, classical optimizations, a bytecode ISA,
and a semi-space copying GC — see research/ for the deeper middle and back end."""
maintainer: ["Aneesh Krishna"]
authors: ["Aneesh Krishna"]
license: "MIT"
homepage: "https://github.com/Aneesh495/glyph"
bug-reports: "https://github.com/Aneesh495/glyph/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.14"}
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Aneesh495/glyph.git"
